                  {image.description}
                </p>

              </div>

            </div>

          ))}

        </div>

        {/* DOT INDICATOR */}
        <div
          style={{
            display: "flex",
            justifyContent: "center",
            alignItems: "center",
            gap: "8px",
            marginTop: "18px"
          }}
        >

          {GALLERY_IMAGES.map((_, index) => (

            <button
              key={index}
              onClick={() => setCurrent(index)}
              aria-label={`Tampilkan gambar ${index + 1}`}
              style={{
                width: index === current ? "26px" : "9px",
                height: "9px",
                padding: 0,
                border: "none",
                borderRadius: "20px",
                cursor: "pointer",
                background:
                  index === current
                    ? "var(--amber)"
