<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>3rd ICON-FAST 2026 — International Conference on Agriculture, Science, and Technology</title>

<script crossorigin src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script crossorigin src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.5/babel.min.js"></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">

<style>
  :root{
    --teal: #046A38;
    --teal-deep: #023D22;
    --amber: #F5821F;
    --sage: #4CAF3C;
    --canvas: #FAFAF6;
    --canvas-dim: #EEF3EB;
    --ink: #14201C;
    --line: rgba(4,106,56,0.14);
    --mono: 'IBM Plex Mono', monospace;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0; background:var(--canvas); color:var(--ink); font-family:'Inter',sans-serif; line-height:1.6;}
  h1,h2,h3,.display{font-family:'Space Grotesk',sans-serif; font-weight:600; letter-spacing:-0.01em; margin:0;}
  a{color:inherit;}
  .wrap{max-width:1140px; margin:0 auto; padding:0 28px;}
  img{max-width:100%; display:block;}

  .nav{position:sticky; top:0; z-index:50; background:rgba(247,247,242,0.92); backdrop-filter:blur(8px); border-bottom:1px solid var(--line);}
  .nav-inner{display:flex; align-items:center; justify-content:space-between; padding:14px 28px; max-width:1140px; margin:0 auto;}
  .brand{display:flex; align-items:center; text-decoration:none;}
  .brand-logo{height:34px; width:auto; display:block;}
  .nav-links{display:flex; gap:24px; list-style:none; margin:0; padding:0; font-size:0.9rem;}
  .nav-links a{text-decoration:none; opacity:0.75; transition:opacity .2s;}
  .nav-links a:hover{opacity:1;}
  .nav-cta{background:var(--teal); color:var(--canvas); padding:9px 18px; border-radius:8px; text-decoration:none; font-size:0.86rem; font-weight:600; white-space:nowrap;}
  .menu-btn{display:none; background:none; border:none; font-size:1.4rem; cursor:pointer; color:var(--teal);}
  @media (max-width:880px){ .nav-links{display:none;} .menu-btn{display:block;} .nav-cta{display:none;} }
  .mobile-menu{display:flex; flex-direction:column; padding:8px 28px 18px; border-bottom:1px solid var(--line);}
  .mobile-menu a{padding:12px 4px; text-decoration:none; border-bottom:1px solid var(--line); font-size:0.94rem;}

  .hero{position:relative; overflow:hidden; background:var(--teal); color:var(--canvas); padding:110px 0 80px;}
  .hero .bignum{
    position:absolute; right:-40px; top:-40px; font-family:var(--mono); font-weight:500;
    font-size:min(42vw,460px); line-height:1; color:rgba(245,130,31,0.5); user-select:none; pointer-events:none;
  }
  .eyebrow{display:inline-flex; align-items:center; gap:8px; font-family:var(--mono); font-size:0.78rem; letter-spacing:0.06em; color:var(--amber); margin-bottom:20px;}
  .eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--amber);}
  .hero h1{font-size:clamp(2rem,4.6vw,3.3rem); line-height:1.12; max-width:800px;}
  .hero .theme-line{font-family:var(--mono); color:var(--sage); font-size:clamp(0.95rem,1.6vw,1.15rem); margin-top:22px; max-width:620px;}
  .hero-meta{display:flex; flex-wrap:wrap; gap:30px; margin-top:42px;}
  .hero-meta div{border-left:2px solid rgba(245,130,31,0.5); padding-left:14px;}
  .hero-meta .label{font-family:var(--mono); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.08em; opacity:0.6;}
  .hero-meta .value{font-family:'Space Grotesk',sans-serif; font-size:1.1rem; margin-top:3px;}
  .hero-actions{display:flex; gap:14px; margin-top:42px; flex-wrap:wrap;}
  .btn-primary{background:var(--amber); color:var(--teal-deep); font-weight:700; padding:14px 26px; border-radius:8px; text-decoration:none; font-size:0.92rem; transition:transform .2s;}
  .btn-primary:hover{transform:translateY(-2px);}
  .btn-ghost{border:1px solid rgba(247,247,242,0.35); color:var(--canvas); padding:14px 26px; border-radius:8px; text-decoration:none; font-size:0.92rem;}

  .countdown{background:var(--teal-deep); color:var(--canvas); padding:16px 0;}
  .countdown .wrap{display:flex; gap:30px; flex-wrap:wrap; align-items:center; justify-content:center;}
  .countdown .num{font-family:var(--mono); font-size:1.5rem; color:var(--amber);}
  .countdown .lbl{font-size:0.66rem; text-transform:uppercase; letter-spacing:0.08em; opacity:0.65;}

  section{padding:84px 0;}
  .section-head{max-width:640px; margin-bottom:44px;}
  .kicker{font-family:var(--mono); font-size:0.75rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--teal); font-weight:600; margin-bottom:10px; display:block;}
  .section-head h2{font-size:clamp(1.6rem,2.8vw,2.2rem);}
  .section-head p{margin-top:12px; opacity:0.72; font-size:1rem;}

  .about-grid{display:grid; grid-template-columns:1.1fr 0.9fr; gap:52px; align-items:start;}
  @media (max-width:880px){.about-grid{grid-template-columns:1fr;}}
  .about-text p{margin:0 0 16px; opacity:0.82;}
  .stat-card{background:var(--canvas-dim); border:1px solid var(--line); border-radius:14px; padding:24px;}
  .stat-row{display:flex; justify-content:space-between; padding:13px 0; border-bottom:1px solid var(--line); font-size:0.94rem;}
  .stat-row:last-child{border-bottom:none;}
  .stat-row .k{opacity:0.6;}
  .stat-row .v{font-weight:600; text-align:right;}

  .topics{background:var(--canvas-dim);}
  .topic-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:16px; overflow:hidden;}
  @media (max-width:900px){.topic-grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:560px){.topic-grid{grid-template-columns:1fr;}}
  .topic-card{background:var(--canvas); padding:26px 22px; min-height:150px; display:flex; flex-direction:column; justify-content:space-between;}
  .topic-card .idx{font-family:var(--mono); color:var(--amber); font-size:0.85rem;}
  .topic-card h3{font-size:0.98rem; margin-top:20px; line-height:1.32; font-weight:600;}

  .timeline{position:relative; padding-left:26px; border-left:2px solid var(--line); display:flex; flex-direction:column; gap:26px;}
  .tl-item{position:relative; padding-left:22px;}
  .tl-item::before{content:""; position:absolute; left:-38px; top:4px; width:12px; height:12px; border-radius:3px; background:var(--amber); border:3px solid var(--canvas); box-shadow:0 0 0 2px var(--amber);}
  .tl-item .date{font-family:var(--mono); font-weight:600; color:var(--teal); font-size:0.98rem;}
  .tl-item .desc{opacity:0.68; font-size:0.9rem; margin-top:3px;}
  .tl-item.final .date{color:var(--amber);}

  .notice{border:1px dashed var(--line); border-radius:14px; padding:20px 24px; background:var(--canvas-dim); font-size:0.9rem; opacity:0.78;}

  .welcome-grid{display:grid; grid-template-columns:0.8fr 1.2fr; gap:48px; align-items:center;}
  @media (max-width:860px){.welcome-grid{grid-template-columns:1fr;}}
  .welcome-photo-frame{
    border-radius:20px; overflow:hidden; border:1px solid var(--line);
    box-shadow:0 18px 40px -20px rgba(4,106,56,0.35); max-width:340px; margin:0 auto;
  }
  .welcome-photo-frame img{width:100%; height:auto; display:block;}
  .welcome-quote .quote-mark{color:var(--amber); opacity:0.5; margin-bottom:8px;}
  .welcome-text{font-family:'Space Grotesk',sans-serif; font-size:1.05rem; line-height:1.55; font-weight:500; opacity:0.9;}
  .welcome-attribution{margin-top:22px; padding-top:16px; border-top:1px solid var(--line);}
  .welcome-attribution .w-name{display:block; font-weight:700; font-size:0.98rem; color:var(--teal);}
  .welcome-attribution .w-title{display:block; font-size:0.85rem; opacity:0.65; margin-top:2px;}

  .fee-grid{display:grid; grid-template-columns:1fr 1fr; gap:22px;}
  @media (max-width:880px){.fee-grid{grid-template-columns:1fr;}}
  .fee-card{border:1px solid var(--line); border-radius:16px; overflow:hidden; background:var(--canvas);}
  .fee-card .fee-head{background:var(--teal); color:var(--canvas); padding:18px 22px; font-family:'Space Grotesk',sans-serif; font-weight:600;}
  .fee-row{display:flex; justify-content:space-between; align-items:center; padding:16px 22px; border-top:1px solid var(--line);}
  .fee-row .cat{font-size:0.92rem;}
  .fee-row .cat small{display:block; opacity:0.55; font-size:0.78rem; margin-top:2px;}
  .fee-row .price{font-family:var(--mono); font-weight:600; color:var(--teal); text-align:right;}
  .fee-note{font-size:0.82rem; opacity:0.65; margin-top:16px;}

  .doc-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px;}
  @media (max-width:880px){.doc-grid{grid-template-columns:1fr;}}
  .doc-card{border:1px solid var(--line); border-radius:14px; padding:22px; background:var(--canvas); display:flex; flex-direction:column; gap:10px;}
  .doc-card .name{font-weight:600; font-size:0.96rem;}
  .doc-card .status{font-family:var(--mono); font-size:0.72rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--amber); background:rgba(245,130,31,0.12); padding:3px 9px; border-radius:100px; align-self:flex-start;}
  .doc-card .status.ready{color:var(--sage); background:rgba(76,175,60,0.15);}
  .doc-card a.dlink{font-size:0.88rem; text-decoration:underline; opacity:0.85; word-break:break-all;}

  .cta-band{background:var(--teal-deep); color:var(--canvas); text-align:center; padding:78px 0;}
  .cta-band h2{font-size:clamp(1.7rem,3.6vw,2.4rem); max-width:620px; margin:0 auto;}
  .cta-band p{opacity:0.68; margin-top:14px;}
  .cta-band .btn-primary{margin-top:0; display:inline-block;}
  .cta-band .btn-ghost{margin-top:0; margin-left:12px; display:inline-block;}
  .contact-grid{display:flex; gap:16px; flex-wrap:wrap; justify-content:center; margin-top:32px;}
  .contact-card{
    display:flex; flex-direction:column; gap:6px; text-align:left;
    background:rgba(250,250,246,0.06); border:1px solid rgba(250,250,246,0.16);
    border-radius:14px; padding:18px 22px; text-decoration:none; color:var(--canvas);
    min-width:220px; transition:background .2s, border-color .2s;
  }
  .contact-card:hover{background:rgba(250,250,246,0.12); border-color:rgba(250,250,246,0.32);}
  .contact-card .cname{font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:0.96rem;}
  .contact-card .cphone{font-family:var(--mono); font-size:0.86rem; color:var(--sage);}

  footer{background:var(--teal-deep); color:rgba(247,247,242,0.6); padding:36px 0; font-size:0.84rem;}
  .footer-inner{display:flex; justify-content:space-between; flex-wrap:wrap; gap:16px; align-items:center;}
  .footer-links{display:flex; gap:18px; list-style:none; padding:0; margin:0;}
  .footer-links a{text-decoration:none; opacity:0.85;}

  .fade-up{animation:fadeUp .7s ease both;}
  @keyframes fadeUp{from{opacity:0; transform:translateY(14px);} to{opacity:1; transform:translateY(0);}}

  @media (max-width:640px){
    .wrap{padding:0 18px;}
    .nav-inner{padding:12px 18px;}
    .brand-logo{height:26px;}
    .hero{padding:64px 0 48px;}
    .hero .bignum{display:none;}
    .eyebrow{margin-bottom:14px; font-size:0.7rem;}
    .hero h1{font-size:1.6rem; line-height:1.2;}
    .hero .theme-line{font-size:0.9rem; margin-top:16px;}
    .hero-meta{flex-direction:column; gap:16px; margin-top:28px;}
    .hero-actions{margin-top:28px; flex-direction:column; align-items:stretch;}
    .hero-actions a{text-align:center;}
    .countdown .wrap{gap:16px 22px;}
    .countdown .unit{flex:0 0 auto;}
    .countdown .unit:last-child{
      flex-basis:100%; border-left:none; padding-left:0;
      order:5; text-align:center; margin-top:4px;
    }
    section{padding:56px 0;}
    .section-head{margin-bottom:32px;}
    .section-head h2{font-size:1.4rem;}
    .topic-card{padding:20px 18px; min-height:auto;}
    .fee-row{padding:14px 18px; flex-wrap:wrap; gap:4px;}
    .fee-row .price{text-align:left;}
    .doc-grid{gap:14px;}
    .cta-band{padding:56px 0;}
    .cta-band h2{font-size:1.4rem;}
    .contact-grid{flex-direction:column; align-items:stretch;}
    .contact-card{min-width:0;}
    .cta-band .btn-primary, .cta-band .btn-ghost{
      display:block; margin-left:0; margin-top:12px; text-align:center;
    }
    .timeline{padding-left:18px;}
    .tl-item{padding-left:16px;}
    .tl-item::before{left:-26px;}
    .welcome-photo-frame{max-width:220px;}
    .welcome-text{font-size:0.96rem;}
    .footer-inner{flex-direction:column; align-items:flex-start; gap:12px;}
  }
</style>
</head>
<body>
<div id="root"></div>

<script type="text/babel" data-presets="react">
const { useState, useEffect } = React;

const LOGO_SRC = "data:image/png;base64,";

const WELCOME_PHOTO_SRC = "data:image/jpeg;base64,";

const NAV_LINKS = [
  { href: "#about", label: "About" },
  { href: "#scope", label: "Scope" },
  { href: "#dates", label: "Timeline" },
  { href: "#fees", label: "Fees" },
  { href: "#documents", label: "Documents" },
  { href: "#committee", label: "Committee" },
  { href: "#travel", label: "Travel Info" },
  { href: "#contact", label: "Contact" },
];

function useCountdown(targetDate) {
  const [left, setLeft] = useState(() => targetDate.getTime() - Date.now());
  useEffect(() => {
    const t = setInterval(() => setLeft(targetDate.getTime() - Date.now()), 1000);
    return () => clearInterval(t);
  }, [targetDate]);
  const clamped = Math.max(left, 0);
  const days = Math.floor(clamped / (1000*60*60*24));
  const hours = Math.floor((clamped/(1000*60*60))%24);
  const mins = Math.floor((clamped/(1000*60))%60);
  const secs = Math.floor((clamped/1000)%60);
  return { days, hours, mins, secs };
}

function Nav() {
  const [open, setOpen] = useState(false);
  return (
    <nav className="nav" id="top">
      <div className="nav-inner">
        <a href="#top" className="brand"><img src={LOGO_SRC} alt="ICON-FAST logo" className="brand-logo" /></a>
        <ul className="nav-links">
          {NAV_LINKS.map(l => <li key={l.href}><a href={l.href}>{l.label}</a></li>)}
        </ul>
        <a className="nav-cta" href="#fees">Register</a>
        <button className="menu-btn" onClick={() => setOpen(!open)} aria-label="Toggle menu">{open ? "✕" : "☰"}</button>
      </div>
      {open && (
        <div className="mobile-menu">
          {NAV_LINKS.map(l => <a key={l.href} href={l.href} onClick={() => setOpen(false)}>{l.label}</a>)}
          <a href="#fees" onClick={() => setOpen(false)}>Register</a>
        </div>
      )}
    </nav>
  );
}

function Hero() {
  const target = new Date("2026-11-18T08:00:00+07:00");
  const { days, hours, mins, secs } = useCountdown(target);
  return (
    <>
      <header className="hero">
        <div className="bignum">03</div>
        <div className="wrap">
          <span className="eyebrow fade-up"><span className="dot"></span>Jurusan Teknologi Pertanian · Politeknik Negeri Pontianak</span>
          <h1 className="fade-up">3rd ICON-FAST 2026</h1>
          <p style={{opacity:0.85, marginTop:14, maxWidth:640}} className="fade-up">
            International Conference on Agriculture, Science, and Technology
          </p>
          <p className="theme-line fade-up">
            "Next-Gen Agriculture: Harnessing Cutting-Edge Science and Smart Technology for Sustainable Future"
          </p>
          <div className="hero-meta fade-up">
            <div><div className="label">Date</div><div className="value">18 November 2026</div></div>
            <div><div className="label">Venue</div><div className="value">Aula Kerinci, POLNEP + Zoom</div></div>
            <div><div className="label">Format</div><div className="value">Hybrid</div></div>
          </div>
          <div className="hero-actions fade-up">
            <a className="btn-primary" href="#fees">Register Now</a>
            <a className="btn-ghost" href="#dates">View Timeline ↓</a>
          </div>
        </div>
      </header>
      <div className="countdown">
        <div className="wrap">
          <div className="unit"><div className="num">{days}</div><div className="lbl">Days</div></div>
          <div className="unit"><div className="num">{hours}</div><div className="lbl">Hours</div></div>
          <div className="unit"><div className="num">{mins}</div><div className="lbl">Minutes</div></div>
          <div className="unit"><div className="num">{secs}</div><div className="lbl">Seconds</div></div>
          <div className="unit" style={{borderLeft:"1px solid rgba(247,247,242,0.2)", paddingLeft:22}}>
            <div style={{fontFamily:"var(--mono)", fontSize:"0.85rem"}}>Until ICON-FAST 2026 opens</div>
          </div>
        </div>
      </div>
    </>
  );
}

function About() {
  return (
    <section id="about">
      <div className="wrap">
        <div className="section-head">
          <span className="kicker">About the Conference</span>
          <h2>Agriculture meets next-gen science & technology</h2>
        </div>
        <div className="about-grid">
          <div className="about-text">
            <p>
              ICON-FAST is organized by the Department of Agricultural Technology (Jurusan Teknologi
              Pertanian), Politeknik Negeri Pontianak. Now in its 3rd edition, the conference brings
              together researchers, academics, and practitioners working at the intersection of
              agriculture, food science, and smart technology.
            </p>
            <p>
              The 2026 edition runs under the theme "Next-Gen Agriculture: Harnessing Cutting-Edge
              Science and Smart Technology for Sustainable Future," and will be held in hybrid format —
              in person at Aula Kerinci, Politeknik Negeri Pontianak, and online via Zoom.
            </p>
          </div>
          <div className="stat-card">
            <div className="stat-row"><span className="k">Organizer</span><span className="v">Jurusan Teknologi Pertanian, POLNEP</span></div>
            <div className="stat-row"><span className="k">Edition</span><span className="v">3rd ICON-FAST</span></div>
            <div className="stat-row"><span className="k">Date</span><span className="v">18 November 2026</span></div>
            <div className="stat-row"><span className="k">Venue</span><span className="v">Aula Kerinci, POLNEP</span></div>
            <div className="stat-row"><span className="k">Format</span><span className="v">Hybrid (Onsite + Zoom)</span></div>
          </div>
        </div>
      </div>
    </section>
  );
}

const TOPICS = [
  "Agricultural Technology",
  "Food Science and Technology",
  "Agronomy",
  "Soil Science",
  "Plant Protection",
  "Biotechnology – Plant Breeding",
  "Socio-Economics of Agriculture",
];

function Welcome() {
  return (
    <section id="welcome" className="topics">
      <div className="wrap">
        <div className="section-head">
          <span className="kicker">Welcome Message</span>
          <h2>Welcome to ICON-FAST!</h2>
        </div>
        <div className="welcome-grid">
          <div className="welcome-photo-frame">
            <img src={WELCOME_PHOTO_SRC} alt="Dody Radiansah, S.P., M.MA." className="welcome-photo" />
          </div>
          <div className="welcome-quote">
            <svg className="quote-mark" width="40" height="32" viewBox="0 0 40 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 32V19.2C0 12.8 1.6 7.73333 4.8 4C8 1.33333 12.2667 0 17.6 0V6.4C14.9333 6.4 12.9333 7.2 11.6 8.8C10.2667 10.1333 9.6 12 9.6 14.4H17.6V32H0ZM22.4 32V19.2C22.4 12.8 24 7.73333 27.2 4C30.4 1.33333 34.6667 0 40 0V6.4C37.3333 6.4 35.3333 7.2 34 8.8C32.6667 10.1333 32 12 32 14.4H40V32H22.4Z" fill="currentColor"/>
            </svg>
            <p className="welcome-text">
              "It is an honor for our department to host bright minds from across the globe.
              This conference reflects our strong commitment to advancing research, driving
              technological innovation, and building international academic networks,
              especially in agricultural technology (processing, management, and crop
              cultivation). We invite you to engage in insightful exchanges and shape the
              future together."
            </p>
            <div className="welcome-attribution">
              <span className="w-name">Dody Radiansah, S.P., M.MA.</span>
              <span className="w-title">Head of Department of Agricultural Technology, Politeknik Negeri Pontianak</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}

function Scope() {
  return (
    <section id="scope" className="topics">
      <div className="wrap">
        <div className="section-head">
          <span className="kicker">Call for Papers</span>
          <h2>Conference scope</h2>
          <p>Original, unpublished manuscripts are invited across the following tracks.</p>
        </div>
        <div className="topic-grid">
          {TOPICS.map((t, i) => (
            <div className="topic-card" key={t}>
              <span className="idx">{String(i+1).padStart(2,"0")}</span>
              <h3>{t}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}

const DATES = [
  { date: "1–22 October 2026", desc: "Registration, abstract submission, and conference payment." },
  { date: "27 October 2026", desc: "Notification of abstract review results." },
  { date: "4 November 2026", desc: "Full paper submission deadline." },
