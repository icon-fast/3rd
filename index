            maxWidth: "1050px",
            height: "500px",
            margin: "0 auto",
            overflow: "hidden",
            borderRadius: "20px",
            border: "1px solid var(--line)",
            boxShadow: "0 18px 40px -20px rgba(4,106,56,0.35)",
            background: "var(--canvas-dim)"
          }}
        >

          {GALLERY_IMAGES.map((image, index) => (

            <div
              key={index}
              style={{
                position: "absolute",
                inset: 0,
                width: "100%",
                height: "100%",
                opacity: index === current ? 1 : 0,
                transform:
                  index === current
                    ? "scale(1)"
                    : "scale(1.03)",
                transition:
                  "opacity 0.7s ease, transform 0.7s ease",
                pointerEvents:
                  index === current ? "auto" : "none"
              }}
            >

              {/* Gambar */}
              <img
                src={image.src}
                alt={image.title}
                style={{
                  width: "100%",
                  height: "100%",
                  display: "block",
                  objectFit: "cover"
                }}
              />

              {/* Overlay teks */}
              <div
                style={{
                  position: "absolute",
                  left: 0,
                  right: 0,
                  bottom: 0,
                  padding: "70px 30px 28px",
                  background:
                    "linear-gradient(transparent, rgba(2,61,34,0.82))",
                  color: "var(--canvas)"
                }}
              >

                <h3
                  style={{
                    margin: "0 0 5px",
                    fontSize: "1.3rem"
                  }}
